---
/**
 * Tarjeta de digestión para la home y el índice.
 *
 * Vive en `apps/web/src/components/` y no en `packages/kit`: depende del
 * routing del sitio, no es una primitiva reutilizable. La regla de §13 ("todo
 * lo que se use dos veces sube a kit") aplica a piezas agnósticas del portal.
 *
 * La tarjeta muestra el HALLAZGO, no el resumen. Es lo que decide si alguien
 * entra, y repetir la bajada en la tarjeta y en la portada gasta el espacio dos
 * veces en lo mismo.
 */
import type { CollectionEntry } from 'astro:content';

import { duracion, fechaISO, formatoFecha } from '@digerido/kit/utils';

interface Props {
  digestion: CollectionEntry<'digestiones'>;
  /** La destacada de la home ocupa más ancho y sube la jerarquía tipográfica. */
  destacada?: boolean;
}

const { digestion, destacada = false } = Astro.props;
const d = digestion.data;
const href = `/digestiones/${digestion.id}/`;

/** Cuánto se comprime la lectura: el número que resume la propuesta. */
const reduccion = Math.round(
  (1 - d.tiempoLectura.digerido / d.tiempoLectura.original) * 100,
);
---

<article class:list={['tarjeta', { 'tarjeta--destacada': destacada }]}>
  <p class="versalita meta">
    <span class="temas">{d.temas.join(' · ')}</span>
    {d.demo && <span class="etiqueta-demo">ejemplo</span>}
    {d.estado === 'borrador' && <span class="etiqueta-demo">borrador</span>}
  </p>

  <h2>
    {/*
      El enlace envuelve solo el título, no la tarjeta entera: un <a> alrededor
      de todo hace que un lector de pantalla anuncie el bloque completo como el
      texto del enlace. El ::after abajo extiende el área clickeable.
    */}
    <a {href}>{d.titulo}</a>
  </h2>

  <p class="hallazgo">{d.hallazgo}</p>

  <dl class="cifras utilidad">
    <div>
      <dt>Original</dt>
      <dd>{duracion(d.tiempoLectura.original)}</dd>
    </div>
    <div>
      <dt>Digerido</dt>
      <dd class="digerido">{duracion(d.tiempoLectura.digerido)}</dd>
    </div>
    <div>
      <dt>Reducción</dt>
      <dd>{reduccion} %</dd>
    </div>
  </dl>

  <p class="utilidad fecha">
    <time datetime={fechaISO(d.fecha)}>{formatoFecha(d.fecha)}</time>
    <span aria-hidden="true"> · </span>
    <span>{d.fuentes[0]?.organismo}</span>
  </p>
</article>

<style>
  .tarjeta {
    position: relative;
    display: grid;
    gap: var(--espacio-sm);
    align-content: start;
    padding: var(--espacio-lg);
    background: var(--color-papel-alto);
    border: 1px solid var(--color-borde);
    transition: border-color var(--duracion-rapida) var(--curva-salida);
  }

  .tarjeta:hover {
    border-color: var(--color-tinta);
  }

  /* `:focus-within` en vez de `:hover` solo: la tarjeta reacciona igual cuando
     se llega con el teclado. */
  .tarjeta:focus-within {
    border-color: var(--color-tinta);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-xs);
    align-items: center;
    color: var(--color-sello);
  }

  /* Un borrador o una pieza de ejemplo se marca en el índice, no solo dentro. */
  .etiqueta-demo {
    background: var(--color-bilis);
    color: var(--color-papel);
    padding-inline: var(--espacio-2xs);
  }

  h2 {
    font-size: var(--tipo-xl);
    margin: 0;
  }

  .tarjeta--destacada h2 {
    font-size: var(--tipo-3xl);
  }

  h2 a {
    text-decoration: none;
  }

  /* Área clickeable completa sin sacrificar el texto del enlace. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-bilis);
  }

  .hallazgo {
    font-size: var(--tipo-sm);
    line-height: var(--interlinea-cuerpo);
    color: var(--color-tinta-suave);
    max-width: var(--medida-angosta);
  }

  .tarjeta--destacada .hallazgo {
    font-size: var(--tipo-base);
    color: var(--color-tinta);
  }

  .cifras {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-md);
    margin-block-start: var(--espacio-2xs);
    padding-block-start: var(--espacio-sm);
    border-block-start: 1px solid var(--color-borde);
    font-variant-numeric: tabular-nums;
  }

  .cifras dt {
    font-size: var(--tipo-3xs);
    letter-spacing: var(--tracking-versalita);
    text-transform: uppercase;
    color: var(--color-sello);
  }

  .cifras dd {
    margin: 0;
    color: var(--color-tinta);
    font-weight: var(--peso-media);
  }

  .digerido {
    color: var(--color-bilis);
  }

  .fecha {
    color: var(--color-sello);
  }
</style>
