    @echo "El agente lee raw/ e interim/ de esta digestión, y te muestra 3 opciones de cada"
    @echo "sección narrativa en PROPUESTA-ARTICULO.md para que elijas antes de que escriba"
    @echo "el index.mdx definitivo."

# Borra intermedios, conserva las descargas crudas.
limpiar-cache:
    rm -rf "{{ justfile_directory() }}/interim"
