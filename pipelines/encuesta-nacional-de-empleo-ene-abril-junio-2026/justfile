raiz := justfile_directory() / "../.."
py := "python3"

default:
    @just --list --unsorted -f "{{ justfile() }}"

# Pipeline completo: descargar → extraer → limpiar → validar → publicar.
todo: descargar extraer limpiar test publicar
    @echo "listo. Actualizá el frontmatter con las métricas del meta.json."
    @echo "próximo paso: just -f pipelines/encuesta-nacional-de-empleo-ene-abril-junio-2026/justfile redactar"

descargar *args:
    cd "{{ raiz }}" && {{ py }} -m pipelines.encuesta-nacional-de-empleo-ene-abril-junio-2026.00_descargar {{ args }}

extraer:
    cd "{{ raiz }}" && {{ py }} -m pipelines.encuesta-nacional-de-empleo-ene-abril-junio-2026.10_extraer

limpiar:
    cd "{{ raiz }}" && {{ py }} -m pipelines.encuesta-nacional-de-empleo-ene-abril-junio-2026.20_limpiar

publicar:
    cd "{{ raiz }}" && {{ py }} -m pipelines.encuesta-nacional-de-empleo-ene-abril-junio-2026.30_publicar

# Bloquean la publicación.
test:
    cd "{{ raiz }}" && {{ py }} -m pytest pipelines/encuesta-nacional-de-empleo-ene-abril-junio-2026/tests -q

# Revalida el hash de la fuente contra el registrado (§13).
revalidar:
    cd "{{ raiz }}" && {{ py }} -m pipelines.encuesta-nacional-de-empleo-ene-abril-junio-2026.00_descargar --forzar

# Paso final (asistido) — propuesta de artículo con el agente redactor-digestion.
# No es un script: el agente vive en .claude/agents/ y solo corre dentro de una
# sesión de Claude Code (no tiene forma de invocarse desde una terminal sola).
redactar:
    @echo "Este paso no corre solo: abrí una sesión de Claude Code en la raíz del repo y pedile"
    @echo ""
    @echo "  Usa el agente redactor-digestion para el slug encuesta-nacional-de-empleo-ene-abril-junio-2026"
