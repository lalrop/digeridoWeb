{
  "name": "@digerido/kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design system y primitivas de visualización compartidas por todas las digestiones.",
  "exports": {
    ".": "./src/index.ts",
    "./charts/*": "./src/charts/*",
    "./scroll/*": "./src/scroll/*",
    "./ui/*": "./src/ui/*",
    "./utils": "./src/utils/index.ts",
    "./estilos.css": "./src/estilos.css"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@digerido/tokens": "workspace:*",
    "d3-array": "3.2.4",
    "d3-format": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-time-format": "4.1.0",
    "scrollama": "3.2.0"
  },
  "devDependencies": {
    "@types/d3-array": "3.2.1",
    "@types/d3-format": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/d3-time-format": "4.0.3",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "svelte": "^5"
  }
}
